<?xml version="1.0" encoding="utf-8"?>
<!-- MSIX package manifest for the Microsoft Store. installer/build-msix.ps1 fills in
     __VERSION__. The Identity and PublisherDisplayName values come from Partner Center
     (Product management > Product identity) and must match it exactly. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="JeffRemec.VeraView"
    Publisher="CN=F46F4FA3-D687-4828-A525-1CB9E0D1CF4B"
    Version="__VERSION__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Vera View</DisplayName>
    <PublisherDisplayName>Jeff Remec</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="VeraView" Executable="vera-view.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Vera View"
        Description="View Microsoft Visio drawings"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\SmallTile.png"
          Square310x310Logo="Assets\LargeTile.png"
          ShortName="Vera View" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Adds Vera View to "Open with" for Visio files. Windows passes the file path
             on the command line, as with the regular installer. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="visiodrawing">
            <uap:DisplayName>Visio Drawing</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.vsdx</uap:FileType>
              <uap:FileType>.vsdm</uap:FileType>
              <uap:FileType>.vstx</uap:FileType>
              <uap:FileType>.vstm</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Required for every desktop (Win32) app in an MSIX package. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
